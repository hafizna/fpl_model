# Local defaults. Copy to .env only for local tooling; never commit .env.
FPL_WEB_RELEASE_PATH=web/release.json
FPL_DATABASE_PATH=data/processed/fpl.duckdb
FPL_WEB_HOST=127.0.0.1
FPL_WEB_PORT=8000
FPL_EXPOSE_API_DOCS=true
FPL_LOG_LEVEL=INFO
FPL_ALLOWED_RELEASE_HEALTH=research,shadow,production
FPL_TRANSFER_SCAN_ENABLED=true
FPL_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FPL_REQUIRE_ALPHA_ACCESS=false
FPL_ALPHA_REQUESTS_PER_MINUTE=60
FPL_ALPHA_TRANSFER_SCANS_PER_MINUTE=2

# Closed-alpha secrets are intentionally omitted. Configure only SHA-256 digests server-side:
# FPL_ALPHA_ACCESS_TOKEN_HASHES=<tester-label>=<sha256>,...
# FPL_ALPHA_ACCESS_TOKEN is client-side/operator-only for smoke_test_web.py; never set it on server.

# Optional worker-only secret. Supply in the scheduler environment, never in browser code.
# FPL_REFRESH_WEBHOOK_URL=https://your-alert-adapter.example/fpl-refresh
