# Local defaults. Copy to .env only for local tooling; never commit .env.
FPL_WEB_RELEASE_PATH=web/release.json
FPL_DATABASE_PATH=data/processed/fpl.duckdb
FPL_EXPOSE_API_DOCS=true
FPL_LOG_LEVEL=INFO
FPL_ALLOWED_RELEASE_HEALTH=research,shadow,production
FPL_TRANSFER_SCAN_ENABLED=true
FPL_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
